{
  "entities": {
    "Usuario": {
      "title": "Usuario",
      "description": "User profile containing personal information and roles.",
      "type": "object",
      "properties": {
        "nombre": { "type": "string", "maxLength": 100 },
        "dni": { "type": "string", "maxLength": 20 },
        "whatsapp": { "type": "string", "maxLength": 20 },
        "fecha_nacimiento": { "type": "string", "maxLength": 20 },
        "sexo": { "type": "string", "enum": ["masculino", "femenino", "otro"] },
        "estado_suscripcion": { "type": "string", "enum": ["activo", "inactivo"] },
        "rol": { "type": "string", "enum": ["admin", "entrenador", "cliente"] },
        "id_entrenador": { "type": "string", "maxLength": 128 },
        "avatar_url": { "type": "string", "maxLength": 500 },
        "color_acento": { "type": "string", "maxLength": 30 },
        "modo_tema": { "type": "string", "enum": ["light", "dark"] }
      },
      "required": ["nombre", "dni", "rol", "estado_suscripcion", "sexo", "fecha_nacimiento"]
    },
    "Ejercicio": {
      "title": "Ejercicio",
      "description": "Global catalog of exercises.",
      "type": "object",
      "properties": {
        "nombre": { "type": "string", "maxLength": 100 },
        "grupo_muscular": { "type": "string", "maxLength": 100 },
        "video_url": { "type": "string", "maxLength": 500 },
        "instrucciones": { "type": "string", "maxLength": 1000 }
      },
      "required": ["nombre", "grupo_muscular"]
    },
    "Rutina": {
      "title": "Rutina",
      "description": "Routine assigned to a client.",
      "type": "object",
      "properties": {
        "id_cliente": { "type": "string", "maxLength": 128 },
        "id_entrenador": { "type": "string", "maxLength": 128 },
        "nombre_sesion": { "type": "string", "maxLength": 100 },
        "dia_semana": { "type": "number", "minimum": 0, "maximum": 6 },
        "es_descanso": { "type": "boolean" }
      },
      "required": ["id_cliente", "id_entrenador", "nombre_sesion", "dia_semana"]
    },
    "EjercicioRutina": {
      "title": "EjercicioRutina",
      "description": "An exercise within a routine.",
      "type": "object",
      "properties": {
        "id_rutina": { "type": "string", "maxLength": 128 },
        "id_ejercicio": { "type": "string", "maxLength": 128 },
        "series_objetivo": { "type": "number", "minimum": 1, "maximum": 20 },
        "reps_objetivo": { "type": "string", "maxLength": 50 },
        "tempo": { "type": "string", "maxLength": 20 },
        "descanso_segundos": { "type": "number", "minimum": 0, "maximum": 600 },
        "rpe_objetivo": { "type": "number", "minimum": 1, "maximum": 10 }
      },
      "required": ["id_rutina", "id_ejercicio", "series_objetivo", "reps_objetivo", "descanso_segundos"]
    },
    "EjercicioRealizado": {
      "title": "EjercicioRealizado",
      "description": "Log of completed exercises with execution times, dates, and series performed.",
      "type": "object",
      "properties": {
        "id_cliente": { "type": "string", "maxLength": 128 },
        "nombre_cliente": { "type": "string", "maxLength": 100 },
        "id_rutina": { "type": "string", "maxLength": 128 },
        "id_ejercicio_rutina": { "type": "string", "maxLength": 128 },
        "id_ejercicio": { "type": "string", "maxLength": 128 },
        "nombre_ejercicio": { "type": "string", "maxLength": 100 },
        "grupo_muscular": { "type": "string", "maxLength": 100 },
        "fecha": { "type": "string", "maxLength": 20 },
        "hora_inicio": { "type": "string", "maxLength": 30 },
        "hora_fin": { "type": "string", "maxLength": 30 },
        "duracion_segundos": { "type": "number", "minimum": 0 },
        "total_series_objetivo": { "type": "number", "minimum": 1 },
        "completado": { "type": "boolean" },
        "completado_at": { "type": "string", "maxLength": 30 }
      },
      "required": ["id_cliente", "id_ejercicio", "nombre_ejercicio", "fecha", "completado"]
    },
    "SesionUso": {
      "title": "SesionUso",
      "description": "Record of web usage dates, times, and duration for athletes and trainers.",
      "type": "object",
      "properties": {
        "id_usuario": { "type": "string", "maxLength": 128 },
        "nombre_usuario": { "type": "string", "maxLength": 100 },
        "rol": { "type": "string", "enum": ["admin", "entrenador", "cliente"] },
        "fecha": { "type": "string", "maxLength": 20 },
        "hora_inicio": { "type": "string", "maxLength": 30 },
        "hora_fin": { "type": "string", "maxLength": 30 },
        "duracion_segundos": { "type": "number", "minimum": 0 },
        "inicio_timestamp": { "type": "number" },
        "ultima_actividad_timestamp": { "type": "number" },
        "dispositivo": { "type": "string", "maxLength": 50 }
      },
      "required": ["id_usuario", "nombre_usuario", "rol", "fecha", "hora_inicio"]
    }
  },
  "firestore": {
    "usuarios/{userId}": {
      "schema": { "$ref": "Usuario" },
      "description": "User profiles. Accessible by the user themselves, their assigned trainer, and admins."
    },
    "ejercicios/{ejercicioId}": {
      "schema": { "$ref": "Ejercicio" },
      "description": "Global exercises catalog. Readable by all authenticated users, writable by admins."
    },
    "rutinas/{rutinaId}": {
      "schema": { "$ref": "Rutina" },
      "description": "Routines for clients. Readable by the client and their trainer. Writable by the trainer and admins."
    },
    "ejerciciosRutina/{ejercicioRutinaId}": {
      "schema": { "$ref": "EjercicioRutina" },
      "description": "Exercises for routines. Same access as Rutinas."
    },
    "ejerciciosRealizados/{logId}": {
      "schema": { "$ref": "EjercicioRealizado" },
      "description": "Completed exercises log visible to the athlete and trainers."
    },
    "sesionesUso/{sesionId}": {
      "schema": { "$ref": "SesionUso" },
      "description": "Web usage timestamps and statistics for athletes and trainers."
    }
  }
}
